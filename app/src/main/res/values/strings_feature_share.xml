<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 课表分享成图（Agent C 专属资源文件）：新文案只能加在本文件，命名必须以 share_ 开头且全局唯一；
         禁止修改 strings.xml 或任何其他 strings_*.xml -->

    <!-- 分享图顶部标题，%1$d = 周号 -->
    <string name="share_week_title">第 %1$d 周课表</string>
    <!-- 系统分享器标题 -->
    <string name="share_chooser_title">分享课表图片</string>
    <!-- 写入相册时的文件名，%1$d = 周号，%2$s = 时间戳 -->
    <string name="share_image_display_name">课表_第%1$d周_%2$s.png</string>
    <!-- 渲染失败提示 -->
    <string name="share_error_render_failed">课表图片生成失败，请稍后重试</string>
    <!-- 保存失败提示 -->
    <string name="share_error_save_failed">课表图片保存失败，请稍后重试</string>
    <!-- 没有可用分享应用 -->
    <string name="share_error_no_share_app">未找到可用的分享应用</string>
</resources>